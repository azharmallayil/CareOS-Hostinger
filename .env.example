# ─────────────────────────────────────────────────────────────────────────────
# CareOS Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Cloud (Singapore — confirmed region: vbckrirksziluvwqpamx) ──────
SUPABASE_URL=https://vbckrirksziluvwqpamx.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── Client-side build (apps/web) ─────────────────────────────────────────────
# Note: Vite injects these into client bundle at build time.
# NEVER put service-role or secret keys in VITE_ variables!
VITE_SUPABASE_URL=https://vbckrirksziluvwqpamx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# ── API Server (Hostinger managed Node.js reads process.env.PORT) ─────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── CORS (for local dev; in production on Hostinger, same-origin is used) ─────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Security & Session Secrets (≥32 random characters each) ───────────────────
COOKIE_SECRET=change-me-to-a-random-32-char-string-in-production
JWT_SECRET=change-me-to-a-random-32-char-string-in-production

# ── Worker Configuration (OCI Always Free ARM64 processor) ────────────────────
# PostgreSQL-backed job outbox — no Redis required in V1
POLL_INTERVAL_MS=3000
LEASE_DURATION_SECONDS=60
WORKER_CONCURRENCY=3

# ── Connectors: SMS ──────────────────────────────────────────────────────────
SMS_PROVIDER=console          # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Connectors: Email ────────────────────────────────────────────────────────
EMAIL_PROVIDER=console        # console | resend
RESEND_API_KEY=

# ── Connectors: Payment ──────────────────────────────────────────────────────
# Provider-neutral in V1 until owner approves a gateway
PAYMENT_PROVIDER=none         # none | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Connectors: ERP & Telematics ─────────────────────────────────────────────
ERP_PROVIDER=none             # none | generic-rest
INTEGRATION_ENCRYPTION_KEY=change-me-to-a-random-32-char-hex-key

# ── Platform Admin IP allowlist (comma-separated CIDRs) ──────────────────────
ADMIN_IP_ALLOWLIST=127.0.0.1/32
